// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Role {
  MEMBER
  ADMIN
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  name              String?
  isVerifed         Boolean       @default(false)
  role              Role           @default(MEMBER)

  membership        Membership[]
  issues            IssueMapping[]
  verifcationTokens VerificationToken[]
  sessions          Session[]

  createdAt         DateTime  @default(now())
}

model Organisation {
  id                String        @id @default(uuid())
  title             String        @unique
  description       String

  membership        Membership[]
  boards            Board[]
}

model Board {
  id                String        @id @default(uuid())
  title             String

  orgId             String


  organisation     Organisation   @relation(fields: [orgId], references: [id])

  issues            Issue[]
  sections          Section[]
}

model Issue {
  id                String        @id @default(uuid())
  title             String
  descripiton       String

  boardId           String
  sectionId         String

  boards            Board         @relation(fields: [boardId], references: [id])
  sections          Section       @relation(fields: [sectionId], references: [id])

  users             IssueMapping[]
  comments          Comment[]
}

model Section {
  id                String        @id @default(ulid())
  title             String
  
  boardId           String

  board             Board         @relation(fields: [boardId], references: [id])


  issues            Issue[]             
}

model Comment {
  id                String      @id @default(uuid())
  title             String
  description       String

  issueId         String

  issue           Issue       @relation(fields: [issueId], references: [id])
}


model VerificationToken {
  id            String      @id @default(uuid())
  tokenHash     String      @unique

  userId        String
  user          User        @relation(fields: [userId], references: [id])


  expiresIn     DateTime
  createdAt     DateTime  @default(now())
}

model Session {
  id            String    @id @default(uuid())
  tokenHash     String    @unique

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt     DateTime
  createdAt     DateTime @default(now())
}


// Join Tables
model Membership {
  id                String        @id @default(uuid())

  userId            String
  orgId             String


  user              User          @relation(fields: [userId], references: [id])
  organisation      Organisation  @relation(fields: [orgId], references: [id])
}


model IssueMapping {
  id                String        @id @default(uuid())

  userId            String
  issueId           String

  user              User         @relation(fields: [userId], references: [id])
  issue             Issue        @relation(fields: [issueId], references: [id])
}





